<Window x:Class="CommentatorApp.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="解说端状态 - 校园直播导播协调系统" Height="600" Width="900"
        WindowState="Maximized" Background="#1a1a2e"
        WindowStartupLocation="CenterScreen">
    <!--
        状态窗口。只放「不用盯着看」的东西：版本号、连接状态、内部消息、版本横幅。

        为什么和播送标题分成两个窗口：标题窗口要整块搬到副屏上，尺寸和主屏
        不一样。挤在一个窗口里的话，副屏一拉伸，这些字也跟着变形；而版本横幅
        这类提示又不能没有——它是「必须让人知道」的那类信息，不能静默。
    -->
    <!--
        右键菜单里那一条「鼠标穿透」是标题窗口的唯一逃生口。

        播送标题现在是一整张 1920×1080 的画面，铺满屏幕时会自动打开鼠标穿透
        （不然操作员连桌面都点不进去）。而穿透之后标题窗口本身就点不到了，
        右键菜单再也唤不出来——所以关掉穿透只能在这里做。此时状态窗口正是
        唯一能点到的窗口。
    -->
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="ClickThroughItem" Header="播送标题：鼠标穿透"
                      IsCheckable="True" IsChecked="False" Click="OnToggleTitleClickThrough"/>
        </ContextMenu>
    </Window.ContextMenu>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <!-- 版本提示条：默认折叠，只在不匹配时由代码显示。 -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="#16213e" Padding="20,0">
            <Grid>
                <TextBlock Text="解说端状态" FontSize="22" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionSelfText" Text="" Foreground="#7d7d9a"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="Red" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="连接中..." Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!--
            版本不一致提示条。

            为什么用可关闭的条而不是 MessageBox：这是解说端，播送中弹对话框会
            挡视线；而「低于最低适配版本」这种必须让人知道的情况又不能完全静默，
            所以给一条常驻在顶部的横幅。点关闭后本次不再打扰，但轮询继续——
            版本再次变化时还会提示。
        -->
        <Border x:Name="VersionBanner" Grid.Row="1" Visibility="Collapsed"
                Background="#2b2038" BorderBrush="#e94560" BorderThickness="0,0,0,1"
                Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="VersionBannerText" Grid.Column="0" Text=""
                           Foreground="#e94560" FontSize="12" VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="VersionSelfVersionText" Grid.Column="1" Text=""
                           Foreground="#7d7d9a" FontSize="11" VerticalAlignment="Center"
                           Margin="12,0"/>
                <Button Grid.Column="2" Content="知道了" Click="OnVersionBannerClose"
                        Background="Transparent" BorderThickness="0" Foreground="#7d7d9a"
                        FontSize="12" Cursor="Hand" Padding="8,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!--
            正文区改成消息流水。播送标题在另一个窗口里，这里空着没意义；
            改成日志之后，现场出问题时能直接看最近发生了什么，而不是去翻控制台。
        -->
        <Border Grid.Row="2" Background="#16213e" Margin="20" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="消息" Foreground="#7d7d9a"
                           FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
                <ListBox x:Name="LogList" Grid.Row="1" Background="Transparent"
                         BorderThickness="0" Foreground="#d0d0e0"
                         FontFamily="Consolas" FontSize="13"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0,3"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- 底部状态栏 -->
        <Border Grid.Row="3" Background="#16213e" Padding="20,0">
            <Grid>
                <TextBlock x:Name="LastUpdateText" Text="等待连接..."
                           Foreground="#666" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="校园直播导播协调系统 v1.0"
                           Foreground="#666" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
