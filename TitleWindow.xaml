<Window x:Class="CommentatorApp.TitleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="播送标题" Width="403" Height="82"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        ShowInTaskbar="False"
        Background="#FF00FF"
        WindowStartupLocation="Manual">


    <!--
        播送标题 = 一块不透明的包装卡片，窗口本身就是这张卡片。

        窗口底色（Background）就是**色度抠像的键色**，代码里按 config.KeyColor 设置。
        卡片轮廓是**阶梯状**的：蓝条只画到 x 288.5、灰底只画到 y 45.5，所以窗口右下角
        （x 288.5..310, y 45.5..87）没有任何元素覆盖，会露出底色。这些位置在原始图形里
        是透明的，而本窗口不能开 AllowsTransparency（分层窗口会被采集成黑屏），所以填
        键色、由采集端抠掉。

        因此不需要额外画任何色块——阶梯状轮廓本身就是「哪些地方不画」构成的。

        为什么不用 AllowsTransparency 的全屏 16:9 浮层：
        1. AllowsTransparency 会让 WPF 建 WS_EX_LAYERED 分层窗口，而分层窗口由
           DWM 合成、不往窗口 DC 里画。采集软件用 PrintWindow（不带
           PW_RENDERFULLCONTENT）或从窗口 DC BitBlt 抓它，拿到的就是一片黑。
           实测：解说端状态窗口（普通不透明窗口）能正常采集，本窗口采不到。
        2. 采集端既然能指定信号源在输出画面里的位置和大小（画中画），窗口就没
           必要自己等于一张 16:9 画面。做成卡片那么大，源更小、缩放更清晰，
           位置交给采集端摆。
        3. 顺带不用再操心「整屏透明浮层挡住桌面」——非透明的小窗口不点它
           就不会吃掉点击，鼠标穿透变成一个纯可选的手动开关。

        命中测试只有整块画布一个入口：下面每一层都是 IsHitTestVisible="False" 的装饰件，
        ContextMenu 与 MouseLeftButtonDown 都挂在 OverlayCanvas 上。早先这里盖过一个
        Fill="Transparent" 的描边矩形——WPF 里透明填充照样参与命中测试（要
        Fill="{x:Null}" 才不测），它又正好盖住 Card，于是挂在 Card 上的 ContextMenu 和
        MouseLeftButtonDown 全都收不到事件：右键弹出来是「什么都没有」，按住也拖不动
        窗口。
    -->
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="置顶显示" IsCheckable="True" IsChecked="True"
                      Click="OnToggleTopmost"/>
            <MenuItem x:Name="ClickThroughItem" Header="鼠标穿透" IsCheckable="True" IsChecked="False"
                      Click="OnToggleClickThrough"/>
            <Separator/>
            <MenuItem Header="显示状态窗口" Click="OnShowStatusWindow"/>
            <Separator/>
            <MenuItem Header="退出解说端" Click="OnQuit"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Canvas x:Name="OverlayCanvas"
            Background="Transparent"
            MouseLeftButtonDown="OnDrag">

        <!-- 灰色主体（只负责底色与轮廓）
             描边由 Layout() 设 BorderThickness 往内画：左、右、下三边描，顶边不描
             （顶边紧贴蓝条下沿，蓝条自己的下描边就是这条缝）。
             BorderBrush 不能省——它就是采集端抠像之后卡片轮廓上那道浅色边。 -->
        <Border x:Name="Card"
                Background="#DAE0E5"
                BorderBrush="#F2F5F7"
                IsHitTestVisible="False"/>


        <!--
            顶部蓝色标题栏。颜色固定，不随状态变。
            描边同上：四边都描，往内 3 个设计单位。
            tools/title-preview.png 实测这道浅色描边有 3.0 个单位宽（预览图 6 像素），
            蓝条与竖条之间、蓝条与灰底之间都是靠它分开的，抠像后必须留住。
        -->
        <Border x:Name="EventBar"
                Background="#0054B7"
                BorderBrush="#F2F5F7"
                IsHitTestVisible="False">
            <TextBlock x:Name="EventNameText"
                       Text=""
                       FontWeight="Bold"
                       Foreground="White"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- 右侧竖条（颜色固定，不随状态变）
             没有描边：实测它与蓝条齐平、同收在蓝条那道描边上，自己再描一圈
             会多出一道图里不存在的边。 -->
        <Border x:Name="AccentBar"
                Background="#0046A5"
                IsHitTestVisible="False"/>

        <!-- 底行：Chip + 机位名 -->
        <Grid x:Name="ProgramRow" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="StateChip" Grid.Column="0" Background="#48C4A0">
                <TextBlock x:Name="StateLabel"
                           Text="正在播送"
                           FontWeight="Bold"
                           Foreground="White"
                           TextAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <TextBlock x:Name="ProgramName"
                       Grid.Column="1"
                       Text="—"
                       FontWeight="Bold"
                       Foreground="#141414"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Canvas>
</Window>
