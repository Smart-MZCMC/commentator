<Window x:Class="CommentatorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="解说端 - 校园直播导播协调系统" Height="600" Width="900"
        WindowState="Maximized" Background="#1a1a2e"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="#16213e" Padding="20,0">
            <Grid>
                <TextBlock Text="解说端" FontSize="22" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="Red" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="连接中..." Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 上半部：正在播送 -->
        <Border Grid.Row="1" Background="#1a1a2e" Margin="20,10,20,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="正在播送" FontSize="18" Foreground="#888" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="1" x:Name="CurrentPlaying"
                           Text="等待导播指令..."
                           FontSize="72" FontWeight="Bold" Foreground="#4ecca3"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 下半部：即将播送 -->
        <Border Grid.Row="2" Background="#0f3460" Margin="20,5,20,10" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="即将播送" FontSize="18" Foreground="#888" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="1" x:Name="NextPreview"
                           Text="等待导播指令..."
                           FontSize="56" FontWeight="Bold" Foreground="#e94560"
                           TextWrapping="Wrap" VerticalAlignment="Center"
                           TextAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 底部状态栏 -->
        <Border Grid.Row="3" Background="#16213e" Padding="20,0">
            <Grid>
                <TextBlock x:Name="LastUpdateText" Text="等待连接..." 
                           Foreground="#666" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="校园直播导播协调系统 v1.0" 
                           Foreground="#666" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
